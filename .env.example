# Supabase Client & Admin Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Service Role Key for Admin Batch Pipeline Scripts (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# LLM Providers for Content Generation Pipeline
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional Alternative Providers
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Next.js Server-side AI Tutor Settings
AI_GATEWAY_API_KEY=your_server_only_gateway_key
AI_TUTOR_MODEL=openai/gpt-5.4-mini

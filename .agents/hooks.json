{
  "harness-push-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [{ "type": "command", "command": "node hooks/push-gate.mjs", "timeout": 20 }]
      }
    ]
  },
  "harness-stop-check": {
    "Stop": [
      { "type": "command", "command": "node hooks/stop-harness.mjs", "timeout": 120 }
    ]
  }
}
